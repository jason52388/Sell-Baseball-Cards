# --- Card identification & grading (photo upload) ---
# Vision provider: auto | anthropic | gemini  (auto uses whichever key is set)
VISION_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Google Gemini alternative (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Stronger Gemini model used by the per-card "Re-analyze" button on a
# low-confidence preview (slower/pricier than the default flash model).
GEMINI_MODEL_HQ=gemini-2.5-pro

# --- eBay pricing data (REAL — no fake numbers) ---
# Get a free developer keyset at https://developer.ebay.com/my/keys
# With these set, the Browse API returns real CURRENT ASKING prices immediately.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Real SOLD prices come from the Marketplace Insights API, which requires eBay
# to approve buy.marketplace.insights access for your app. Once approved:
EBAY_INSIGHTS_ENABLED=false

# --- More real SOLD-price sources (optional) ---
# PriceCharting API token — real card market/sold prices, works immediately.
# https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
# The token's API returns only AGGREGATE prices. Enable this to also scrape the
# SportsCardsPro product page for the INDIVIDUAL recent-sales list (no official
# API, ToS-gray). Verify markup first: python -m tools.verify_sportscardspro "..."
SPORTSCARDSPRO_SALES_ENABLED=false
# Best-effort headless-browser scrape of eBay sold pages (per-card, on demand).
# Requires: pip install playwright && playwright install chromium. ToS-gray.
EBAY_BROWSER_SCRAPE_ENABLED=false
# 130point.com sold-comp lookups. Adds recent sales INCLUDING the real
# best-offer-accepted prices eBay hides on public completed listings (additive
# to Insights/SportsCardsPro). Best-effort scrape, no official API, ToS-gray.
POINT130_ENABLED=false

# --- eBay listing ---
# preview = build the real listing payload but publish NOTHING (no creds needed)
# sandbox = publish to eBay sandbox | live = publish to real eBay
EBAY_MODE=preview
EBAY_USER_REFRESH_TOKEN=
# RuName (redirect URL name) for the one-time user-consent flow that creates the
# refresh token above. Create it in the eBay portal and point its "auth accepted
# URL" at <public URL>/ebay/oauth/callback, then visit /ebay/oauth/start.
EBAY_RU_NAME=
# Marketplace Account Deletion notification — REQUIRED to activate PRODUCTION
# keys. Pick any 32-80 char token ([A-Za-z0-9_-]); paste the same value into
# eBay's portal. The endpoint URL must EXACTLY match what you register there.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_CATEGORY_ID=261328
# Category for SET / lot listings (selling several cards as one listing).
# 261329 = Sports Trading Card Lots.
EBAY_LOT_CATEGORY_ID=261329
EBAY_CONDITION=USED_VERY_GOOD
# Public URL where saved crops are reachable by eBay (required for LIVE listings)
PUBLIC_IMAGE_BASE_URL=

# --- Business rules ---
MIN_STORE_VALUE=4.0
CONFIDENCE_THRESHOLD=0.7
PRICE_MARKUP=1.5
MAX_CARDS=9
VERIFY_IDENTIFICATION=true
COMP_RECENCY_DAYS=90
MIN_EXACT_COMPS=3
# Which SOLD source drives the estimate when several return a price. Matched as
# a prefix of the comp's source name (sportscardspro / 130point / ebay).
PRIMARY_SOLD_SOURCE=sportscardspro

# --- Caching (reduce price-API load) ---
# Reuse a cached set of comps for a card identity for this many days before
# re-querying the price APIs. Sold/market prices move slowly. 0 = disable cache.
# Default (36525 = ~100 years) effectively never expires: refresh on demand with
# the "Refresh prices" button instead of paying for re-queries on a timer.
PRICE_CACHE_TTL_DAYS=36525
# Refreshes ACCUMULATE dated sold sales as price history instead of overwriting.
# Keep accumulated sales for this many days (0 = keep forever). Active asking
# prices and undated aggregate prices are always replaced, never accumulated.
PRICE_HISTORY_RETENTION_DAYS=365
# Download the marketplace reference photo locally instead of hot-linking eBay.
LOCALIZE_REFERENCE_IMAGES=true

# --- Optional web-search pricing fallback ---
WEBSEARCH_API_KEY=

# Move a card's original source photo(s) here once it is added to the collection
# (archival; e.g. an iCloud Drive folder). Blank = disabled.
COLLECTION_PHOTOS_DIR=

# --- Cropping ---
# Padding added around each detected card box, as a fraction of the box, so
# edges aren't clipped. Raise if crops shave the card border.
CROP_PADDING_PCT=0.08
# Find the card's actual rectangle with OpenCV and straighten it (deskew).
CROP_AUTOSTRAIGHTEN=true

# --- Selling-cost model (drives the "Est. selling expenses" KPI) ---
# eBay final-value fee as a fraction of the sale price.
EBAY_FEE_PCT=0.1325
# Fixed eBay fee charged per order.
EBAY_PER_ORDER_FEE=0.40
# Your packaging cost per card (sleeve, toploader, mailer).
SUPPLIES_COST_PER_CARD=0.60

# --- SportsCardsPro / PriceCharting ---
# Base URL for the pricing catalogue. Change only if the site moves.
CARDPRICING_API_BASE=https://www.sportscardspro.com
