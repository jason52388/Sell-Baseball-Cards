# eBay Marketplace Account Deletion responder configuration.
# Installed to /etc/ebay-deletion.env by install.sh (root-readable only).

# Any 32-80 char string of [A-Za-z0-9_-]. Must ALSO be pasted into the eBay
# portal as the "Verification token". Reuse your existing token if you have one
# (then you only change the URL in the portal, not the token).
EBAY_VERIFICATION_TOKEN=replace-with-your-32-80-char-token

# Must EXACTLY match the "Marketplace account deletion notification endpoint"
# URL registered in the eBay portal — it is part of the SHA-256 challenge hash.
EBAY_DELETION_ENDPOINT_URL=https://YOURSUB.duckdns.org/ebay/account-deletion

# Loopback only; Caddy terminates TLS and reverse-proxies to this.
BIND=127.0.0.1
PORT=8787
